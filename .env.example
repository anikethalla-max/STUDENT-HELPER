LEARN_TOPIC_PROVIDER=groq
LEARN_TOPIC_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Set to an installed Ollama embedding model to enable hybrid retrieval.
RAG_EMBEDDING_MODEL=
# Set to nomic-embed-text to enable chat search with local Chroma and Ollama.
CHAT_EMBEDDING_MODEL=
CHAT_EMBEDDING_URL=http://127.0.0.1:11435
# Port of the local Chroma server.
CHROMA_PORT=8000
OPENAI_API_KEY=
LANGSMITH_API_KEY=
# Optional. Without a key, Deep Research uses rate-limited Tavily MCP search.
TAVILY_API_KEY=
# Optional PostgreSQL connection. Copy to .env and provide your app role credentials.
DATABASE_URL=
